{
  "uid": "heartbeat-pipeline",
  "title": "Heartbeat Pipeline",
  "tags": ["heartbeat", "kafka"],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Messages processed",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(consumer_messages_processed_total)",
          "legendFormat": "processed"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "DLQ events",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "red" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(consumer_dlq_messages_total)",
          "legendFormat": "dlq"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Abnormal events",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "orange" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(consumer_abnormal_events_total)",
          "legendFormat": "abnormal"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Late events",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "purple" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(consumer_late_events_total)",
          "legendFormat": "late"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Messages per second",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(consumer_messages_processed_total[1m]))",
          "legendFormat": "processed/sec"
        },
        {
          "refId": "B",
          "expr": "sum(rate(consumer_messages_failed_total[1m]))",
          "legendFormat": "failed/sec"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Processing latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(consumer_processing_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(consumer_processing_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(consumer_processing_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Watermark lag",
      "description": "Seconds between wall-clock now and the watermark. Rises when the stream stalls or falls behind.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "consumer_watermark_lag_seconds",
          "legendFormat": "lag — {{instance}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Late events by aggregate outcome",
      "description": "aggregated=true landed in an open window. aggregated=false arrived past allowed lateness, so the raw event was kept but the finalized window was left unchanged.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (aggregated) (increase(consumer_late_events_total[5m]))",
          "legendFormat": "aggregated={{aggregated}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Windows",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(consumer_windows_open)",
          "legendFormat": "open"
        },
        {
          "refId": "B",
          "expr": "sum(consumer_windows_finalized_total)",
          "legendFormat": "finalized (cumulative)"
        }
      ]
    }
  ]
}
