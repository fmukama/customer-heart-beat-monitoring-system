# -------------------------
# PostgreSQL
# -------------------------

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=heartbeat
POSTGRES_USER=heartbeat_user
POSTGRES_PASSWORD=heartbeat_password


# -------------------------
# Kafka
# -------------------------

KAFKA_PORT=9092

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_HEART_RATE_TOPIC=heart-rate-events
KAFKA_HEART_RATE_DLQ_TOPIC=heart-rate-events-dlq

KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1


# -------------------------
# Kafka Producer
# -------------------------

KAFKA_PRODUCER_CLIENT_ID=heartbeat-producer

KAFKA_ACKS=all
KAFKA_RETRIES=5

KAFKA_LINGER_MS=5
KAFKA_BATCH_SIZE=16384
KAFKA_COMPRESSION_TYPE=gzip


# -------------------------
# Kafka Consumer
# -------------------------

KAFKA_CONSUMER_GROUP_ID=heartbeat-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest

MAX_RETRY_ATTEMPTS=4


# -------------------------
# Event time / windowing
# -------------------------

# Watermark = max_event_time_seen - ALLOWED_OUT_OF_ORDERNESS_SECONDS
ALLOWED_OUT_OF_ORDERNESS_SECONDS=300

# Grace period past window_end before a window is finalized.
ALLOWED_LATENESS_SECONDS=3600

WINDOW_FLUSH_INTERVAL_SECONDS=30
KAFKA_POLL_TIMEOUT_MS=1000


# -------------------------
# Monitoring
# -------------------------

METRICS_PORT=8000

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_password


# -------------------------
# Simulator
# -------------------------

SIMULATOR_CUSTOMER_COUNT=10
SIMULATOR_EVENTS_PER_SECOND=1

SIMULATOR_NORMAL_MIN=60
SIMULATOR_NORMAL_MAX=100

SIMULATOR_ABNORMAL_MIN=40
SIMULATOR_ABNORMAL_MAX=180
SIMULATOR_ABNORMAL_PROBABILITY=0.05

# Probability an event_time is backdated, arriving out of order.
SIMULATOR_OUT_OF_ORDER_PROBABILITY=0.05
SIMULATOR_MAX_BACKDATE_SECONDS=600

# Set to an integer for reproducible runs.
SIMULATOR_SEED=
